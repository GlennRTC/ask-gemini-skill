{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadGeminiKey",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:__REGION__:__ACCOUNT_ID__:parameter__KEY_PARAM__"
    },
    {
      "Sid": "DecryptKeyViaSsm",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": { "StringEquals": { "kms:ViaService": "ssm.__REGION__.amazonaws.com" } }
    },
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:__REGION__:__ACCOUNT_ID__:log-group:/aws/lambda/__FUNCTION_NAME__:*"
    }
  ]
}
